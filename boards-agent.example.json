{
  // `boards-agent setup` writes this file to ~/.config/boards-agent/config.json; you don't need to copy it.
  // The Boards web app, web API and MCP endpoint. Defaults: production.
  "webUrl": "https://boards.laraue.com",
  "apiUrl": "https://boards.laraue.com/boards-api",
  "mcpUrl": "https://boards.laraue.com/boards-mcp/mcp",
  // The organization the API key belongs to. Setup sets it; the key itself is in the Keychain, never here.
  "organizationId": 1,
  // When this environment variable is set, it overrides the stored key. Claude Code receives the key through it.
  "apiKeyEnv": "BOARDS_AGENT_API_KEY",
  // Where your clones are (searched three levels deep). A space's repositories are its links in Boards whose URL
  // matches a clone's git remote; each issue gets a worktree per repository on branch agent/<KEY>.
  "codeFolders": ["~/Repos"],
  // Optional: a repository mapped to a space by hand, for one the space has no link to.
  "spaces": {
    "BRD": { "repo": "~/Repos/my-project", "baseRef": "origin/main" }
  },
  // Where the worktrees go: <worktreeFolder>/<KEY>. The agents' logs go here in both workspace modes.
  "worktreeFolder": "~/boards-agent-worktrees",
  // Where the agent works: "worktree" (a worktree per issue) or "checkout" (your own clones, one issue at a time;
  // it asks before switching a clone with uncommitted changes or on another branch).
  "workspace": "worktree",
  // The coding agent: "claude" (Claude Code) or "codex" (OpenAI Codex). Setup asks when both are installed.
  "agent": "claude",
  // "claude" = the one on PATH, or else the newest one bundled with the Claude desktop app.
  "claudePath": "claude",
  // "codex" = the one on PATH.
  "codexPath": "codex",
  // Codex only: let the commands it runs reach the network (package restores - but also git push). Off by default.
  "codexNetworkAccess": false,
  // Limits for one run: Claude Code's --max-turns and --max-budget-usd, and a wall-clock timeout (Codex: the timeout only).
  "maxTurns": 50,
  "maxBudgetUsd": 5,
  "timeoutMinutes": 60,
  // Claude Code only: what it may run without asking, besides editing files in the worktree. Everything else is denied;
  // git push, gh, WebFetch and WebSearch are always denied. Add your project's build/test commands here.
  "allowedTools": [
    "Bash(dotnet build:*)", "Bash(dotnet test:*)", "Bash(dotnet restore:*)",
    "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
    "Bash(git add:*)", "Bash(git commit:*)"
  ],
  "pollIntervalSeconds": 60,
  // How often a working run is checked for a cancel and the timeout.
  "cancelCheckSeconds": 30
}
