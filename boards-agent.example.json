{
  // `boards-agent setup` writes this file to ~/.config/boards-agent/config.json; you don't need to copy it.
  // The Boards web app, web API and MCP endpoint. Defaults: production.
  "webUrl": "https://boards.laraue.com",
  "apiUrl": "https://boards.laraue.com/boards-api",
  "mcpUrl": "https://boards.laraue.com/boards-mcp/mcp",
  // The organization the API key belongs to. Setup sets it; the key itself is in the Keychain, never here.
  "organizationId": 1,
  // When this environment variable is set, it overrides the stored key. Claude Code receives the key through it.
  "apiKeyEnv": "BOARDS_AGENT_API_KEY",
  // Space key -> the local repository its issues are worked on in. Only these spaces are polled.
  // Each issue gets a worktree on branch agent/<KEY>, started from baseRef (default HEAD); the checkout itself isn't touched.
  "spaces": {
    "BRD": { "repo": "~/Repos/my-project", "baseRef": "origin/main" }
  },
  // Where the worktrees go: <worktreeFolder>/<KEY>.
  "worktreeFolder": "~/boards-agent-worktrees",
  // "claude" = the one on PATH, or else the newest one bundled with the Claude desktop app.
  "claudePath": "claude",
  // Limits for one run: Claude Code's --max-turns and --max-budget-usd, and a wall-clock timeout.
  "maxTurns": 50,
  "maxBudgetUsd": 5,
  "timeoutMinutes": 60,
  // What the agent may run without asking, besides editing files in the worktree. Everything else is denied;
  // git push, gh, WebFetch and WebSearch are always denied. Add your project's build/test commands here.
  "allowedTools": [
    "Bash(dotnet build:*)", "Bash(dotnet test:*)", "Bash(dotnet restore:*)",
    "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
    "Bash(git add:*)", "Bash(git commit:*)"
  ],
  "pollIntervalSeconds": 60,
  // How often a working run is checked for a cancel and the timeout.
  "cancelCheckSeconds": 30
}
